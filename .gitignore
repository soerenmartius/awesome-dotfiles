# Compiled Python files
*.pyc

# Folder view configuration files
.DS_Store

# Thumbnail cache files
._*
Thumbs.db

# Files that might appear on external disks
.Spotlight-V100
.Trashes

# IntelliJ
.idea

# Dotfiles we don't want to track
.extra

# Claude Code: only the user settings and custom agents are dotfiles. Everything
# else under ~/.claude (credentials, sessions, history, plugin cache) is state.
.claude/*
!.claude/settings.json
!.claude/agents/
